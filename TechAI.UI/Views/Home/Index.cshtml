<!DOCTYPE html>
<html lang="zxx">
    @await Component.InvokeAsync("_LayoutHead")
    <body> 
    @await Component.InvokeAsync("_LayoutRightSideBar")
        
        <header id="back-header" class="back-header">
            @await Component.InvokeAsync("_LayoutHeader")
            @await Component.InvokeAsync("_LayoutNavbar")
        </header>
        <div class="back-wrapper">
            <div class="back-hero-area md-mt-40">
                <div class="container">
                    <div class="row">
                    @await Component.InvokeAsync("_DefaultSlider")
                    @await Component.InvokeAsync("_DefaultFeature")
                    </div>
                    @await Component.InvokeAsync("_DefaultCategoriesWithLastArticles")
                </div>
            </div>

            @await Component.InvokeAsync("_DefaultTrendingStories")

            @await Component.InvokeAsync("_DefaultLatestPosts")

            @await Component.InvokeAsync("_SubFeature")

            @await Component.InvokeAsync("_DefaultPostsWithVideos")

            @await Component.InvokeAsync("_SecondFeaturePost")

            @await Component.InvokeAsync("_DefaultSubSlider")
        </div>        

        @await Component.InvokeAsync("_DefaultFooter")


        @await Component.InvokeAsync("_LayoutScripts")
    </body>
</html>